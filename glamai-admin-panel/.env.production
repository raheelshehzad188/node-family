# Production Environment Configuration

# Backend Configuration
NODE_ENV=production
PORT=5000

# Database Configuration
MONGODB_URI=mongodb://admin:secure_password@mongodb:27017/glamai_admin?authSource=admin
REDIS_URL=redis://:secure_redis_password@redis:6379

# Authentication
JWT_SECRET=your_production_jwt_secret_key_here_change_this
JWT_EXPIRE=7d
OTP_SECRET=your_production_otp_secret_key_here_change_this

# GlamAI API Configuration
GLAMAI_API_BASE_URL=https://api.glam.ai/api/v1
GLAMAI_API_KEY=your_production_glamai_api_key_here

# AWS S3 Configuration (optional)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_BUCKET_NAME=glamai-uploads-production
AWS_REGION=us-east-1

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your_email_password

# Frontend URL
FRONTEND_URL=https://admin.glamai.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Admin User (for initial setup)
ADMIN_EMAIL=admin@glamai.com
ADMIN_PASSWORD=SecureAdminPassword123!